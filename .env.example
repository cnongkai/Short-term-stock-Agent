# ============================================================
# 短线股票推荐 Agent - 环境变量配置 (对应 PRD Phase 0 用户配置)
# 使用方法: cp .env.example .env 然后填入真实 API Key
# ============================================================

# === LLM 配置 (默认 DeepSeek, OpenAI 兼容接口) ===
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=deepseek
DEEP_THINK_LLM=deepseek-chat
QUICK_THINK_LLM=deepseek-chat
# 可选: 智谱 GLM
# ZHIPU_API_KEY=
# LLM_PROVIDER=glm
# DEEP_THINK_LLM=glm-4-plus
# QUICK_THINK_LLM=glm-4-flash

# === 数据源配置 (PRD 6.10 数据流图) ===
# AkShare: 主数据源, 免费, 无需 token (行情/财务/龙虎榜/资金流/新闻/板块)
AKSHARE_ENABLED=true
# BaoStock: 备用数据源, 免费, 无需 token
BAOSTOCK_ENABLED=true
# Tushare: 备用数据源, 需 token (https://tushare.pro 注册)
TUSHARE_ENABLED=false
TUSHARE_TOKEN=
# 腾讯财经: 独立 fallback (V2.3, qt.gtimg.cn, 独立域名差异化覆盖)
TENCENT_ENABLED=true
TENCENT_HTTP_TIMEOUT=15
# efinance: 独立 fallback (V2.3, 封装东财/腾讯, pip install efinance)
EFINANCE_ENABLED=true
# 巨潮资讯网: 公告检索 (PRD 8.6 个股发展信息分析数据源)
CNINFO_ENABLED=true

# === 政策信源配置 (PRD 6.3, V2 新增 6 类权威信源) ===
POLICY_SOURCES_ENABLED=true
# 政策信源抓取最小间隔(秒), 遵守合规要求 (PRD 11.2: <=1次/5分钟)
POLICY_RATE_LIMIT_SECONDS=300
# 政策信源全部故障时降级到四大证券报 RSS (PRD 10.2)
POLICY_FALLBACK_RSS=true

# === ReAct 迭代循环配置 (PRD 6.7, V2 新增) ===
# 分析师 ReAct 最大迭代次数
REACT_MAX_ITERATIONS=5
# 每次迭代最大工具调用数
REACT_MAX_TOOLS_PER_ITER=3
# 单个分析师总工具调用上限
REACT_MAX_TOTAL_TOOLS=10
# 单次工具调用超时(秒) (PRD 8.7)
TOOL_CALL_TIMEOUT=30
# 工具结果缓存时间(秒) (PRD 8.7: 1小时)
TOOL_CACHE_TTL=3600

# === 辩论与风控配置 (PRD 6.9 多智能体辩论时序) ===
# 看多/看空研究辩论轮次 (实际发言次数 = 2 * 轮次)
MAX_DEBATE_ROUNDS=2
# 三风格风险辩论轮次 (实际发言次数 = 3 * 轮次)
MAX_RISK_DISCUSS_ROUNDS=1
# LangGraph 递归上限
MAX_RECUR_LIMIT=200

# === 选股参数 (PRD 7.3 双路候选个股池 / 6.6 黑马扫描信号) ===
# 主线热门板块选股数量范围
HOT_SECTOR_POOL_MIN=5
HOT_SECTOR_POOL_MAX=8
# 支线黑马扫描最大数量
DARK_HORSE_MAX=3
# 黑马入选评分阈值 (PRD 6.6: 综合评分>=60)
DARK_HORSE_SCORE_THRESHOLD=60
# 板块推理输出 Top N
SECTOR_TOP_N=5

# === 股票板块过滤 (默认仅分析主板, 高风险板块需显式开启) ===
# 创业板 (300/301开头, 20%涨跌幅限制)
ANALYZE_CHINEXT=false
# 科创板 (688开头, 20%涨跌幅限制)
ANALYZE_STAR_MARKET=false
# ST/*ST 股票 (涨跌幅5%限制, 退市风险)
ANALYZE_ST_STOCKS=false

# === 熔断机制 (PRD 10.2 极端行情) ===
# 大盘单日跌幅超过此百分比触发熔断暂停推荐
CIRCUIT_BREAKER_DROP_PCT=4.0

# === 路径配置 ===
RESULTS_DIR=./results
LOG_DIR=./results/logs

# === 调试 ===
DEBUG=false
